# App
VERSION=0.1.0
APP_TITLE=SYM Admin
PROJECT_NAME=SYM Admin
APP_DESCRIPTION=SYM Admin
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=9999
PUBLIC_SITE_URL=https://example.com

# CORS
CORS_ORIGINS=["https://example.com","https://www.example.com","https://admin.example.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sym
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sym

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage
STORAGE_DRIVER=r2
MEDIA_UPLOAD_MAX_FILE_SIZE=524288000
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket>
R2_REGION=auto
R2_ACCESS_KEY=<access-key-id>
R2_SECRET_KEY=<secret-access-key>
R2_PUBLIC_BASE_URL=https://static.example.com
R2_FORCE_PATH_STYLE=true

# Product import temporary files
PRODUCT_IMPORT_MAX_FILE_SIZE=2147483648
PRODUCT_IMPORT_CHUNK_SIZE=5242880
PRODUCT_IMPORT_MAX_CONCURRENCY=2
PRODUCT_IMPORT_MAX_WORKERS=4
PRODUCT_IMPORT_CLEANUP_ENABLED=true
PRODUCT_IMPORT_CLEANUP_RETENTION_HOURS=24
PRODUCT_IMPORT_CLEANUP_INTERVAL_SECONDS=3600

# Media orphan cleanup
MEDIA_ORPHAN_CLEANUP_ENABLED=true
MEDIA_ORPHAN_CLEANUP_DRY_RUN=true
MEDIA_ORPHAN_RETENTION_HOURS=24
MEDIA_ORPHAN_CLEANUP_INTERVAL_SECONDS=21600
MEDIA_ORPHAN_CLEANUP_BATCH_SIZE=1000
MEDIA_ORPHAN_CLEANUP_PREFIXES=logo/,contacts/,home-layout/,items/images/,items/videos/

# Nginx
NGINX_DEFAULT_CONF_FILE=nginx.bootstrap.conf
