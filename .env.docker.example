# =========================
# 基础运行配置
# =========================

# 是否开启调试模式。
# Docker 生产部署建议 false。
DEBUG=false

# API 服务监听地址。
# Docker 容器内必须监听 0.0.0.0，供其他容器访问。
APP_HOST=0.0.0.0

# API 服务监听端口。
APP_PORT=9999

# 对外站点地址。
# 填你的正式域名，例如 https://example.com。
PUBLIC_SITE_URL=xxx


# =========================
# PostgreSQL 数据库
# =========================

# PostgreSQL 主机名。
# Docker Compose 内通过服务名互联，所以这里用 postgres。
POSTGRES_HOST=postgres

# PostgreSQL 端口。
POSTGRES_PORT=5432

# PostgreSQL 用户名。
POSTGRES_USER=sym

# PostgreSQL 密码。
POSTGRES_PASSWORD=xxx

# PostgreSQL 数据库名。
POSTGRES_DB=sym


# =========================
# Redis / Celery
# =========================

# Redis 地址。
REDIS_URL=redis://redis:6379/0

# Celery Broker 地址。
CELERY_BROKER_URL=redis://redis:6379/0

# Celery 结果存储地址。
CELERY_RESULT_BACKEND=redis://redis:6379/1


# =========================
# 鉴权 / Token
# =========================

# JWT 签名密钥。
# 生产环境必须替换。
SECRET_KEY=xxx

# JWT 算法。
JWT_ALGORITHM=HS256

# JWT 访问令牌有效期，单位分钟。
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080


# =========================
# 商品导入任务
# =========================

# 单个导入文件允许的最大体积，单位字节。
PRODUCT_IMPORT_MAX_FILE_SIZE=2147483648

# 分片上传时单片大小，单位字节。
PRODUCT_IMPORT_CHUNK_SIZE=5242880

# 导入时允许的最大并发任务数。
PRODUCT_IMPORT_MAX_CONCURRENCY=2

# 导入流程内部最大 worker 数。
PRODUCT_IMPORT_MAX_WORKERS=4

# 是否开启临时文件清理。
PRODUCT_IMPORT_CLEANUP_ENABLED=true

# 临时文件保留时长，单位小时。
PRODUCT_IMPORT_CLEANUP_RETENTION_HOURS=24

# 清理任务执行间隔，单位秒。
PRODUCT_IMPORT_CLEANUP_INTERVAL_SECONDS=3600


# =========================
# 文件存储
# =========================

# 存储提供商。
STORAGE_PROVIDER=qiniu

# 七牛 AccessKey。
QINIU_ACCESS_KEY=xxx

# 七牛 SecretKey。
QINIU_SECRET_KEY=xxx

# 七牛 Bucket 名称。
QINIU_BUCKET=xxx

# 七牛绑定域名。
# 不要带 http:// 或 https://。
QINIU_DOMAIN=xxx

# 七牛域名协议。
# 你当前 .env 用的是 http，如果线上已启 HTTPS 可以改成 https。
QINIU_DOMAIN_SCHEME=http

# 七牛存储区域。
# 例如 z2、z1、na0、as0。
QINIU_REGION=z2

# Bucket 是否为私有空间。
# 你当前 .env 用的是 true，这里保持一致。
QINIU_IS_PRIVATE=true

# 私有链接过期时间，单位秒。
QINIU_URL_EXPIRE_SECONDS=3600

# 上传超时时间，单位秒。
QINIU_UPLOAD_TIMEOUT_SECONDS=300
